<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --bg: #f5f5f7; --fg: #1d1d1f; --muted: #6e6e73; --line: #c9c9d0;
    --blue: #0071e3; --purple: #5e5ce6; --green: #10a37f; --red: #d6473f; --amber: #c97c12;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #1d1d1f; --fg: #f5f5f7; --muted: #a1a1a8; --line: #3a3a44;
      --blue: #4da3ff; --purple: #8985ff; --green: #2dc79a; --red: #ff6b5e; --amber: #e8a64a; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
    line-height: 1.55; padding: 2rem 1rem; }
  .wrap { max-width: 880px; margin: 0 auto; }
  header { text-align: center; margin-bottom: 2rem; }
  header h1 { font-size: 1.8rem; margin: 0 0 .25rem; }
  header p { color: var(--muted); margin: 0; font-size: .95rem; }
  .badge { display: inline-block; padding: .15rem .5rem; border-radius: 999px; font-size: .72rem; font-weight: 600; margin-left: .4rem; }
  .stub { background: var(--amber); color: #fff; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: .92rem; }
  th, td { padding: .6rem .5rem; text-align: left; border-bottom: 1px solid var(--line); }
  th { font-weight: 600; color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .gap-neg { color: var(--red); font-weight: 600; }
  .gap-pos { color: var(--green); font-weight: 600; }
  .gap-zero { color: var(--muted); }
  .match { color: var(--green); font-weight: 600; }
  .pub { color: var(--purple); }
  .legend { color: var(--muted); font-size: .8rem; margin: 1rem 0 2rem; }
  .callout { background: color-mix(in srgb, var(--red) 10%, transparent); border-left: 3px solid var(--red); padding: .8rem 1rem; border-radius: 6px; margin: 1rem 0; }
  .callout.stub-call { background: color-mix(in srgb, var(--amber) 12%, transparent); border-color: var(--amber); }
  .prov { background: color-mix(in srgb, var(--blue) 6%, transparent); border-radius: 8px; padding: 1rem 1.2rem; margin: .6rem 0; }
  .prov h4 { margin: 0 0 .4rem; font-size: .9rem; }
  .prov ul { margin: 0; padding-left: 1.1rem; }
  .prov li { color: var(--muted); font-size: .82rem; margin-bottom: .15rem; }
  .key { color: var(--blue); }
  footer { text-align: center; color: var(--muted); font-size: .8rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  a { color: var(--blue); }
  code { background: color-mix(in srgb, var(--fg) 8%, transparent); padding: .1rem .3rem; border-radius: 4px; font-size: .85em; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ title }}</h1>
    <p>per-vendor harness assumptions → matched-score comparison on <strong>{{ matrix.bench | upper }}</strong> ({{ matrix.n_problems }} problems)</p>
    <p style="margin-top:.4rem;">generated {{ generated_at }}</p>
  </header>

  {% if matrix.all_stub %}
  <div class="callout stub-call">
    <strong>STUB mode</strong> — no API keys were set, so matched scores are deterministic
    stand-ins, not vendor-representative. Set <code>DEEPSEEK_API_KEY</code> /
    <code>DASHSCOPE_API_KEY</code> / <code>MOONSHOT_API_KEY</code> for live comparison.
  </div>
  {% endif %}

  <table>
    <thead>
      <tr>
        <th>Vendor</th><th>Model</th>
        <th class="num">Published %</th><th class="num">Matched %</th>
        <th class="num">Gap</th><th class="num">Correct</th><th class="num">Mode</th>
      </tr>
    </thead>
    <tbody>
    {% for r in matrix.sort_by_matched() %}
      <tr>
        <td class="key">{{ r.vendor }}</td>
        <td>{{ r.model_id }}</td>
        <td class="num pub">{{ r.published_str }}</td>
        <td class="num match">{{ r.matched_str }}</td>
        <td class="num {% if r.gap is none %}gap-zero{% elif r.gap < 0 %}gap-neg{% elif r.gap > 0 %}gap-pos{% else %}gap-zero{% endif %}">{{ r.gap_str }}</td>
        <td class="num">{{ r.n_correct }}/{{ r.n_problems }}</td>
        <td class="num">{% if r.stub %}stub{% else %}live{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <p class="legend">
    Gap = matched − published. <span class="gap-neg">Negative</span> = the vendor's
    harness inflated the headline number under matched assumptions; a negative gap
    is procurement-relevant evidence. <span class="gap-zero">—</span> = no published
    score to compare against.
  </p>

  {% set lg = matrix.largest_gap %}
  {% if lg and lg.gap is not none and lg.gap < 0 %}
  <div class="callout">
    <strong>Largest harness inflation:</strong> {{ lg.vendor }} / {{ lg.model_id }}
    — published {{ lg.published_str }}%, matched {{ lg.matched_str }}%,
    gap <span class="gap-neg">{{ lg.gap_str }}</span> pts. Under a matched harness
    this vendor's headline lead narrows; cite this in the RFP 答辩.
  </div>
  {% endif %}

  {% if runs %}
  <h2 style="font-size:1.1rem; margin-top:2rem;">Per-profile provenance trail</h2>
  <p class="legend">The reverse-engineered assumption set behind each matched score — this is the audit trail a procurement team needs.</p>
  {% for run in runs %}
  <div class="prov">
    <h4><span class="key">{{ run.vendor }}</span> / {{ run.model_id }}
      — reasoning_effort: <code>{{ run.profile.reasoning_effort or "none" }}</code>,
      temperature: <code>{{ run.profile.temperature }}</code>,
      max_tokens: <code>{{ run.profile.max_tokens }}</code>,
      stop_tokens: <code>{{ run.profile.stop_tokens | tojson }}</code></h4>
    <ul>
      {% for src in run.profile.provenance %}
      <li>{{ src }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
  {% endif %}

  <footer>
    Generated by HarnessProbe · <a href="https://github.com/SuperMarioYL/harnessprobe">github.com/SuperMarioYL/harnessprobe</a> · MIT © 2026 SuperMarioYL
  </footer>
</div>
</body>
</html>
